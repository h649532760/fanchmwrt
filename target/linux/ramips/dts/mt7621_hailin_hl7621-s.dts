/*
 * Hailin HL7621-S MT7621 16M Flash 256M DDR3
 * U-Boot 1.1.3 old version, DO NOT add static pcie child node
 * GPIO:
 * GPIO0  -> Blue Power LED (Active Low)
 * GPIO1  -> WiFi LED (Active Low)
 * GPIO2  -> 4G Modem LED (Active Low)
 * GPIO3  -> I2C SDA for PCF8563 RTC
 * GPIO4  -> I2C SCL for PCF8563 RTC
 * GPIO13 -> 4G Modem Power Control (Output High = Power On)
 * GPIO18 -> Reset Button (Active Low)
 * GPIO19 -> PCIe WiFi PERST# (User script control, DTS no binding)
*/
#include "mt7621.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "hailin,hl7621-s", "mediatek,mt7621-soc";
	model = "Hailin HL7621-S";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		label-mac-device = &gmac0;
		serial0 = &uartlite;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
		stdout-path = &uartlite;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
		};

		wifi {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		modem {
			function = LED_FUNCTION_INDICATOR;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
		};
	};

	i2c {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 3 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 4 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;

		pcf8563@51 {
			compatible = "nxp,pcf8563";
			reg = <0x51>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <40000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x030000 0x010000>;
				read-only;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x040000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_wifi: eeprom@8000 {
						reg = <0x8000 0x4da8>;
					};
					macaddr_gmac0: macaddr@e000 {
						reg = <0xe000 0x6>;
					};
				};
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x050000 0xfb0000>;
			};
		};
	};
};

&pcie {
	status = "okay";
	/* No reset-gpios here, PERST# control in user script */
};

&gmac0 {
	status = "okay";
	nvmem-cells = <&macaddr_gmac0>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";
	label = "wan";
	phy-handle = <&ethphy4>;
	nvmem-cells = <&macaddr_gmac0>;
	nvmem-cell-names = "mac-address-increment";
};

&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "lan1";
		};
		port@1 {
			status = "okay";
			label = "lan2";
		};
		port@2 {
			status = "okay";
			label = "lan3";
		};
		port@3 {
			status = "okay";
			label = "lan4";
		};
		port@4 {
			status = "okay";
			phy-mode = "rgmii";
		};
	};
};

&sdhci {
	status = "okay";
};

&uartlite {
	status = "okay";
};

&xhci {
	status = "okay";
};

&state_default {
	gpio {
		groups = "wdt", "rgmii2", "jtag", "mdio", "nand";
		function = "gpio";
	};
};
