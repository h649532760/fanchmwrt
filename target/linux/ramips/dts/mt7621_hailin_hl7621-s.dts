// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
// DTS for Hailin HL7621-S (4G Industrial Router)
// 适配 fanchmwrt (基于 OpenWrt 25.12 / Linux 6.x)
//
// 硬件规格（根据 PCB 丝印确认）：
//   SoC:    MT7621AT 双核 880MHz
//   RAM:    256MB DDR3
//   Flash:  16MB SPI NOR (40MHz)
//   WiFi:   Atheros AR5BHB116 (AR9287, Mini PCIe, 2.4G+5G 双频, ath9k)
//   4G:     移远 EC20/EC25（USB，GPIO13 电源控制）
//   USB:    USB 3.0 (xHCI)
//   SD:     SDHCI (SD 卡槽)
//   RTC:    PCF8563 (I2C GPIO 模拟)
//   UART:   57600 baud
//   LAN:    4× LAN + 1× WAN
//
// PCB 丝印 GPIO 分配：
//   GPIO0  → 电源 LED (蓝)
//   GPIO1  → WiFi LED (绿)
//   GPIO2  → 4G LED (绿)
//   GPIO3/4 → I2C SDA/SCL (RTC PCF8563)
//   GPIO13 → 4G 模块电源控制 (POWER 4G)
//   GPIO14 → WiFi 控制
//   GPIO16 → WiFi 控制 (WIFI)
//   GPIO17 → LED17
//   GPIO18 → Reset 按键
//   GPIO19 → PERST_N (PCIe 复位，专用于 WiFi AR9287)

/dts-v1/;

#include "mt7621.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "hailin,hl7621-s", "mediatek,mt7621-soc";
	model = "Hailin HL7621-S";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		label-mac-device = &gmac0;
		serial0 = &uartlite;
	};

	chosen {
		bootargs = "console=ttyS0,57600";
		stdout-path = &uartlite;
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-0 {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
		};

		led-1 {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
		};

		led_4g: led-2 {
			label = "green:4g";
			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	/* GPIO 导出控制
	 * GPIO13 = 4G 模块电源 (POWER 4G)
	 * GPIO14/GPIO16 = WiFi 控制 (PCB 丝印: GPIO16 WIFI GPIO14)
	 * GPIO19 = PERST_N (PCIe 复位，由内核 PCIe 子系统自动管理)
	 */
	gpio-export {
		compatible = "gpio-export";

		modem_power {
			gpio-export,name = "modem_power";
			gpio-export,output = <1>;
			gpios = <&gpio 13 GPIO_ACTIVE_HIGH>;
		};
	};

	/* I2C GPIO 模拟（用于 RTC PCF8563） */
	i2c {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;

		rtc@51 {
			compatible = "nxp,pcf8563";
			reg = <0x51>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <40000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x4da8>;
					};

					eeprom_factory_8000: eeprom@8000 {
						reg = <0x8000 0x4da8>;
					};

					macaddr_factory_e000: macaddr@e000 {
						reg = <0xe000 0x6>;
					};
				};
			};

			partition@50000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x50000 0xfb0000>;
			};
		};
	};
};

/* PCIe WiFi: Atheros AR5BHB116 (AR9287, ath9k, Mini PCIe 双频)
 * GPIO19 = PERST_N 由 PCIe 子系统自动管理 */
&pcie {
	status = "okay";
};

&pcie0 {
	wifi@0,0 {
		compatible = "pci168c,002e";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_8000>;
		nvmem-cell-names = "eeprom";
		ieee80211-freq-limit = <2400000 2500000>, <5000000 6000000>;
	};
};

&gmac0 {
	status = "okay";
	nvmem-cells = <&macaddr_factory_e000>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";
	label = "wan";
	phy-handle = <&ethphy4>;

	nvmem-cells = <&macaddr_factory_e000>;
	nvmem-cell-names = "mac-address";
	mac-address-increment = <1>;
};

&ethphy4 {
	/delete-property/ interrupts;
};

&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "lan1";
		};

		port@1 {
			status = "okay";
			label = "lan2";
		};

		port@2 {
			status = "okay";
			label = "lan3";
		};

		port@3 {
			status = "okay";
			label = "lan4";
		};
	};
};

&sdhci {
	status = "okay";
};

&uartlite {
	status = "okay";
};

&xhci {
	status = "okay";
};

&state_default {
	gpio {
		groups = "wdt", "rgmii2", "jtag", "mdio", "nand";
		function = "gpio";
	};
};
